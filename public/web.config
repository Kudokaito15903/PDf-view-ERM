<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Gỡ bỏ tiền tố /pdfviewer hoặc /view khi tìm file vật lý trên cổng 6868 -->
        <rule name="Remove Prefix for Static Files on 6868" stopProcessing="true">
          <match url="^(pdfviewer|view)/(.*)$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{DOCUMENT_ROOT}/{R:2}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:2}" />
        </rule>

        <!-- Chuyển tiếp mọi đường dẫn ảo (như /view hay /pdf/view) về index.html để React SPA xử lý -->
        <rule name="SPA Fallback Routing for Vite React" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Không viết lại nếu request là một file tĩnh thực tế (CSS, JS, hình ảnh, config.js) -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- Không viết lại nếu request là một thư mục thực tế -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    
    <staticContent>
      <!-- Hỗ trợ các định dạng file MIME cần thiết cho ứng dụng React và file PDF trên IIS -->
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="application/javascript" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
